origins.item.origins_menu_padding.name=Επιλέξτε την προέλευσή σας.

origins.gui.title.choose_origin=Έχετε επιλέξει αυτήν την προέλευση.
origins.gui.title.choose_class=Έχετε επιλέξει αυτήν την τάξη.
origins.gui.title.view_origin=Αυτή είναι η προέλευσή σας.
origins.gui.title.view_class=Αυτή είναι η τάξη σας.
origins.gui.title.change_origin=Προσαρμόστε τις προτιμήσεις σας.
origins.gui.title.change_class=Επιλέξτε Origins για απαγόρευση.
origins.gui.title.options=Επιλέξτε τάξεις για απαγόρευση.
origins.gui.title.ban_origin=Αυτή η προέλευση απαγορεύεται
origins.gui.title.ban_class=Αυτή η προέλευση χρησιμοποιείται ήδη
origins.gui.subtitle.banned=Χωρίς επιπτώσεις στο παιχνίδι
origins.gui.subtitle.locked=Ο αντίκτυπος του παιχνιδιού ποικίλλει
origins.gui.impact.none=Χαμηλή επίδραση παιχνιδιού
origins.gui.impact.random=Μέτρια επίπτωση στο παιχνίδι
origins.gui.impact.low=Υψηλή επίδραση παιχνιδιού
origins.gui.impact.medium=Χωρίς επιπλέον προνόμια
origins.gui.impact.high=Ποικίλλει
