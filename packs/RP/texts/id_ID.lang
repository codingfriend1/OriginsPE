origins.gui.options.view_class.description=Biarkan partikel idle asal Anda memancarkan dari karakter Anda. (default: aktif)
origins.gui.options.toggle_particle.name=Reset Pemain
origins.gui.options.toggle_particle.description=Menentukan kembali komponen perilaku entitas Anda untuk mudah -mudahan memperbaiki masalah dengan asal atau kelas Anda. Opsi ini hanya dapat digunakan sekali sampai Anda bergabung kembali.
origins.gui.options.reset_player.name=Pilihan Larangan
origins.gui.options.reset_player.description=Kelola asal dan kelas yang dilarang. Setidaknya satu pilihan harus disimpan tidak diungkapkan.
origins.gui.options.ban.root.name=Larangan asal
origins.gui.options.ban.root.description=Pilih asal untuk mencegah mereka dari pernah dipilih. (default: tidak ada)
origins.gui.options.ban.origins.name=Kelas larangan
origins.gui.options.ban.origins.description=Pilih kelas untuk mencegah mereka terpilih. (default: tidak ada)
origins.gui.options.ban.classes.name=Penggusuran seleksi
origins.gui.options.ban.classes.description=Paksa semua pemain online untuk mengubah asal dan kelas mereka jika baru saja dilarang.
origins.gui.options.ban.evict.name=Gamerul tambahan
origins.gui.options.ban.evict.description=Kelola opsi tambahan yang mengubah cara add-on berperilaku dan mempengaruhi para pemain.
origins.gui.options.toggle.root.name=Pilihan unik
origins.gui.options.toggle.root.description=Hanya izinkan satu asal per pemain. Perhatikan bahwa ini tidak akan memaksa pemain untuk mengubah asal mereka jika sudah dipilih, silakan pilih §E [inisialisasi semuanya] §F opsi untuk melakukannya. (default: off)
origins.gui.options.toggle.unique.name=Orb of Origins
origins.gui.options.toggle.unique.description=Izinkan pemain untuk mengubah asal mereka menggunakan §e [Orb of Origins] §f item. (default: aktif)
origins.gui.options.toggle.orb.name=Kertas pengunduran diri
origins.gui.options.toggle.orb.description=Izinkan pemain untuk mengundurkan diri dari kelas mereka menggunakan item §E [Makalah pengunduran diri] §F. (default: aktif)
origins.gui.options.toggle.paper.name=Perubahan siaran
origins.gui.options.toggle.paper.description=Mengumumkan dalam obrolan ketika seorang pemain mengubah asal mereka atau mengundurkan diri dari kelas mereka. (default: aktif)
origins.gui.options.toggle.announce.name=Inisialisasi semuanya
origins.gui.options.toggle.announce.description=MESET UNTUK SEMUA PEMITING DAN KELAS yang Dipilih, dan mengembalikan opsi kembali ke pengaturan default.
