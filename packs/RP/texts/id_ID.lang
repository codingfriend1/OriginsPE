origins.trait.launch_into_air.name=Bersayap
origins.trait.launch_into_air.description=Anda memiliki sayap elytra tanpa perlu melengkapi apa pun, dan tidak pernah hilang atau tidak dapat dihapus.
origins.trait.elytra.name=Hal -hal penting
origins.trait.elytra.description=Anda mempertahankan akses ke inventaris penting, memastikan hotbar Anda tidak hilang setelah mati.
origins.trait.essentials.name=Cepat
origins.trait.essentials.description=Menjadi gesit dan cepat, memberi Anda peningkatan kecepatan gerakan, memungkinkan Anda untuk melintasi medan dengan mudah.
origins.trait.swift.name=Akrobatik
origins.trait.swift.description=Dengan kaki yang kuat, melompati 2 blok tinggi saat berlari - hancur rintangan dan menghindari bahaya dengan mudah.
origins.trait.sprint_jump.name=Ringan
origins.trait.sprint_jump.description=Jatuh seperti bulu: Jangan ambil kerusakan, jangan pernah bosan dengan sprint atau melompat, tetapi waspadalah - serangan lain sakit 10% lebih.

origins.trait.lightweight.description=Teleportasi

origins.trait.throw_ender_pearl.name=Tidak ada ruang untuk berteleportasi di sana!
origins.trait.throw_ender_pearl.description=Quiver yang tak ada habisnya
origins.trait.throw_ender_pearl.failed=Panah Anda tidak pernah kering. Memegang busur Anda dengan amunisi yang tak terbatas dan ketepatan tanpa henti.
origins.trait.endless_quiver.name=Penembak jitu
origins.trait.endless_quiver.description=Berurusan 30% lebih banyak kerusakan dengan serangan jarak jauh. Tujuan Anda adalah utusan kematian sendiri.
origins.trait.marksman.name=Ganas
origins.trait.marksman.description=Lepaskan Fury Primal. Dapatkan kekuatan I dan hancurkan musuh dalam jarak dekat.
origins.trait.ferocious.name=Rentan
origins.trait.ferocious.description=Daya datang dengan harga - ambil 20% lebih banyak kerusakan akibat serangan entitas. Jadilah cepat, tidak sembrono.




origins.trait.smash.name=Keras
origins.trait.smash.description=Tumbuhkan 4 hati bonus dan dapatkan 20% resistensi untuk semua bentuk kerusakan. Anda adalah garis depan.
origins.trait.tough.name=Kulit yang tidak bisa dipecahkan
origins.trait.tough.description=Berikan langit - ambil kerusakan 30% lebih sedikit dari proyektil. Panah memantul dari tekad besi Anda.
origins.trait.unbreakable_skin.name=Berat
origins.trait.unbreakable_skin.description=Daya besar beratnya berat. Pindahkan 5% lebih lambat dan knalpot dua kali lebih cepat - tetapi kekuatan Anda tidak tertandingi.

origins.trait.heavy.description=Memberdayakan aura

origins.trait.empowering_aura.name=⚠ Aura di cooldown!
origins.trait.empowering_aura.description=Umur panjang
origins.trait.empowering_aura.cooldown=Dapatkan 2 hati tambahan dan lebih lama dari musuh Anda. Setiap napas adalah kesempatan kedua.
origins.trait.longevity.name=Memori yang bagus
origins.trait.longevity.description=Inventaris Anda kembali dengan Anda dari kuburan. Kematian hanyalah kemunduran.
origins.trait.good_memory.name=Perlawanan kelaparan
origins.trait.good_memory.description=Bertahan liar. Kurangi kelelahan hingga 20% dari semua kegiatan dan tetap lebih lama.
origins.trait.hunger_resistant.name=Aura Kelaparan
origins.trait.hunger_resistant.description=Memberdayakan Sekutu Anda: Semua pemain dalam 16 blok mendapatkan perlawanan kelaparan hanya dengan berada di dekat Anda.




origins.trait.invisibility.name=⚠ tembus pandang di cooldown!
origins.trait.invisibility.description=⚠ Tidak dapat menggunakan tembus pandang saat terhalang!
origins.trait.invisibility.cooldown=Nokturnal
origins.trait.invisibility.hindered=Di tempat -tempat di mana level cahaya rendah, Anda secara otomatis mendapatkan efek status kekuatan dan penglihatan malam.
origins.trait.cat_vision.name=Kamuflase
origins.trait.cat_vision.description=Anda berbaur dengan lingkungan ketika Anda menyelinap, gerombolan yang bermusuhan itu tidak akan menyerang Anda - kecuali jika Anda menyerang mereka terlebih dahulu.
origins.trait.camouflage.name=Licik
origins.trait.camouflage.description=Papan nama Anda tidak pernah selalu terlihat, bahkan ketika Anda tidak menyelinap.
origins.trait.sneaky.name=Serangan yang melemahkan
origins.trait.sneaky.description=Melumpuhkan musuhmu. Massa apa pun yang Anda tekan diperlambat selama 4 detik - mereka tidak akan pernah lepas dari murka Anda.
origins.trait.debilitating_strikes.name=Lebih kecil
origins.trait.debilitating_strikes.description=Ukuran Anda berkurang 25%, membuat Anda lebih sulit untuk ditargetkan.
origins.trait.smaller.name=Kebutuhan untuk mobilitas
origins.trait.smaller.description=Armor berat memperlambat Anda hingga 50%. Anda dibuat untuk kecepatan, tidak slugging keluar dalam baja.




origins.perk.ore_vein_miner.name=Ekskavator Veteran
origins.perk.ore_vein_miner.description=Anda tidak kehilangan kelaparan saat menambang.
origins.perk.no_mining_exhaustion.name=Penambang yang diberkati
origins.perk.no_mining_exhaustion.description=Anda diberkati dengan Fortune +1 pada pickxe apa pun yang Anda gunakan. Berkat ini tidak ditransfer ke orang lain.




origins.perk.fall_resistant.name=Langkah Pembangun
origins.perk.fall_resistant.description=Anda dilatih untuk skala struktur dengan mudah, melompat dua kali lebih tinggi untuk mencapai tepian dan bingkai.

origins.perk.high_jumper.description=Intuisi Prospector


origins.perk.ore_instinct.description=undefined




