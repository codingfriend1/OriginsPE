origins.trait.launch_into_air.name=Okrídlený
origins.trait.launch_into_air.description=Máte krídla Elytra bez toho, aby ste sa museli vybaviť, a nikdy sa nestratí ani nemožno odstrániť.
origins.trait.elytra.name=Základy
origins.trait.elytra.description=Udržujete prístup k základnému inventáru a zabezpečíte, aby sa váš panel nestratil po smrti.
origins.trait.essentials.name=Rýchly
origins.trait.essentials.description=Staňte sa svižnými a rýchlymi a poskytnite vám zvýšenú rýchlosť pohybu, čo vám umožní bez námahy prechádzať terénom.
origins.trait.swift.name=Akrobacia
origins.trait.swift.description=Pri silných nohách skočte 2 bloky vysoké pri sprinte - rozdrvte prekážky a ľahko sa vyhýbajte nebezpečenstvu.
origins.trait.sprint_jump.name=Ľahký
origins.trait.sprint_jump.description=Padnúť ako perie: Neustále nepokoje, nikdy nepleštevujte šprinting alebo skákanie, ale dajte si pozor - ďalšie útoky poškodzujú o 10% viac.

origins.trait.lightweight.description=Teleportácia

origins.trait.throw_ender_pearl.name=Žiadny priestor na teleportujte tam!
origins.trait.throw_ender_pearl.description=Nekonečný chvenie
origins.trait.throw_ender_pearl.failed=Vaše šípky nikdy nespúšťajú suché. Vlate luk s nekonečnou muníciou a neúnavnou presnosťou.
origins.trait.endless_quiver.name=Strelec
origins.trait.endless_quiver.description=Zaoberajte sa o 30% viac škody pri útokoch na diaľku. Váš cieľ je vlastný posol Death.
origins.trait.marksman.name=Divoký
origins.trait.marksman.description=Uvoľnite prvotnú zúrivosť. Získajte silu I a rozdrvte nepriateľov v tesnej štvrti.
origins.trait.ferocious.name=Krehký
origins.trait.ferocious.description=Sila prichádza za cenu - pri útokoch na entitu urobte o 20% viac škody. Buďte rýchle, nie bezohľadne.




origins.trait.smash.name=Tvrdý
origins.trait.smash.description=Pestujte 4 bonusové srdcia a získajte 20% odpor voči všetkým formám poškodenia. Ste frontová línia.
origins.trait.tough.name=Nerozbitná pokožka
origins.trait.tough.description=Odhýbajte oblohu - z projektilov urobte o 30% menšie škody. Šípky sa odrazia od vášho železa.
origins.trait.unbreakable_skin.name=Ťažkosť
origins.trait.unbreakable_skin.description=Masívna energia váži ťažká. Pohybujte sa o 5% pomalšie a výfuku dvakrát rýchlejšie - ale vaša sila je neprekonateľná.

origins.trait.heavy.description=Splnomocnenie aury

origins.trait.empowering_aura.name=⚠ Aura na Cooldown!
origins.trait.empowering_aura.description=Dlhovekosť
origins.trait.empowering_aura.cooldown=Získajte 2 ďalšie srdcia a prejdite svojich nepriateľov. Každý dych je druhá šanca.
origins.trait.longevity.name=Dobrú pamäť
origins.trait.longevity.description=Váš inventár sa s vami vracia z hrobu. Smrť je iba neúspech.
origins.trait.good_memory.name=Odpor
origins.trait.good_memory.description=Vydržať divočinu. Znížte vyčerpanie o 20% zo všetkých aktivít a zostaňte plní dlhšie.
origins.trait.hunger_resistant.name=Hladová aura
origins.trait.hunger_resistant.description=Posilnite svojich spojencov: Všetci hráči v 16 blokoch získajú odpor hladu len tým, že sú vo vašom okolí.




origins.trait.invisibility.name=⚠ Neviditeľnosť na Cooldown!
origins.trait.invisibility.description=⚠ Nemôžem používať neviditeľnosť, keď je bránená!
origins.trait.invisibility.cooldown=Nočný
origins.trait.invisibility.hindered=Na miestach, kde je hladina svetla nízka, automaticky získate efekty stavu sily a stavu nočného videnia.
origins.trait.cat_vision.name=Maskovanie
origins.trait.cat_vision.description=Zmiešate sa do prostredia, keď sa plížite, tie nepriateľské davy vás prirodzene nezaútočia - pokiaľ na ne zaútočíte najskôr.
origins.trait.camouflage.name=Záludný
